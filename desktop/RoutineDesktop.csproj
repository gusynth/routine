<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>../assets/routine.ico</ApplicationIcon>
    <AssemblyName>RoutineDesktop</AssemblyName>
    <Version>1.3.0</Version>
    <RootNamespace>RoutineDesktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" /></ItemGroup>
  <ItemGroup>
    <Compile Remove="LauncherBootstrap.cs" />
    <Compile Remove="controller/**/*.cs" />
    <Page Remove="WindowFrame.xaml" />
    <Content Include="WindowFrame.xaml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
