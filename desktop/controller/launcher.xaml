<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Routine | Iniciar" Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#0C0D0F" Foreground="#F4F4F6" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
<Window.Resources>
 <Duration x:Key="MotionDuration">0:0:0.24</Duration>
 <Style TargetType="Button"><Setter Property="Background" Value="#191A1D"/><Setter Property="Foreground" Value="#DCDCE3"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="48"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#15FFFFFF" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" From="1" To="0.88" Duration="{StaticResource MotionDuration}" FillBehavior="Stop"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" From="0.88" To="1" Duration="{StaticResource MotionDuration}" FillBehavior="Stop"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
 <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#D7D9E5"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.Background><RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="0.65"><GradientStop Color="#18191E" Offset="0"/><GradientStop Color="#0C0D0F" Offset="1"/></RadialGradientBrush></Grid.Background>
<StackPanel x:Name="LauncherContent" Margin="32,28,32,26"><StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
 <Grid Margin="0,0,0,30"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image x:Name="BrandMark" Width="40" Height="40" Stretch="Uniform"/><Grid x:Name="BrandWordmarkHost" Grid.Column="1" Width="142" Height="35" HorizontalAlignment="Left" Margin="9,0,0,0"><Image x:Name="BrandWordmark" Width="142" Height="35" Stretch="Uniform"/></Grid><Border Grid.Column="2" CornerRadius="12" Padding="9,5" Background="#08FFFFFF" VerticalAlignment="Center"><TextBlock x:Name="Edition" Text="LOCAL" FontSize="9" Foreground="#AAB4CE"/></Border></Grid>
 <TextBlock Text="Seu espaço.&#10;Seu ritmo." FontSize="33" FontWeight="SemiBold" LineHeight="40"/>
 <TextBlock Text="Tudo o que você precisa. Um treino de cada vez." Foreground="#AEB5C8" FontSize="12" Margin="0,12,0,26"/>
 <Border CornerRadius="14" BorderBrush="#12FFFFFF" BorderThickness="1" Background="#04FFFFFF" Padding="19"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse Width="6" Height="6" Fill="#F4F4F6" Margin="0,0,8,0"/><TextBlock Text="SEU ESPAÇO LOCAL" Foreground="#92929F" FontSize="9"/></StackPanel><TextBlock x:Name="Status" Text="Tudo pronto para começar." FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/><TextBlock x:Name="Detail" Text="Escolha onde quer usar o Routine. Seus registros ficam neste computador." Foreground="#9696A3" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"/></StackPanel></Border>
 <TextBlock Text="NO COMPUTADOR" Foreground="#7E7E8D" FontSize="9" Margin="4,24,0,9"/>
 <Button x:Name="Launch" Content="Abrir meu espaço  →" Background="#F4F4F6" Foreground="#111214" MinHeight="54" FontSize="14"/>
 <TextBlock Text="Aplicativo em janela própria, pronto para sua sessão." Foreground="#81818F" FontSize="11" TextWrapping="Wrap" Margin="5,8,0,0"/>
 <Button x:Name="MobileOnly" Content="Usar somente no celular  ↗" Background="#17181B" MinHeight="52" Margin="0,18,0,0"/>
 <TextBlock Text="Liga o servidor e mostra o QR Code, sem abrir o app no PC." Foreground="#81818F" FontSize="11" TextWrapping="Wrap" Margin="5,8,0,20"/>
 <Button x:Name="Repair" Content="Resolver e iniciar" Visibility="Collapsed" Background="#3B3025" Margin="0,0,0,12"/>
 <Border Height="1" Background="#0CFFFFFF" Margin="0,0,0,18"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="Phone" Content="Conectar celular" IsEnabled="False" FontSize="11"/><Button x:Name="CloseLauncher" Content="Encerrar Routine" Grid.Column="2" Background="#04FFFFFF" Foreground="#B8B8C5" FontSize="11"/></Grid>
 <TextBlock x:Name="PhoneHint" Text="PC e celular precisam estar na mesma rede Wi-Fi." Foreground="#7D7D8D" FontSize="10" TextWrapping="Wrap" Margin="4,10,0,0"/>
 <TextBlock Text="Depois de iniciar, encontre o Routine perto do relógio.&#10;O servidor continua ativo até você escolher encerrar." Foreground="#727282" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" LineHeight="17" Margin="0,22,0,0"/>
</StackPanel></Grid></ScrollViewer></Window>