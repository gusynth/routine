<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Routine.Setup.Preview</AssemblyName><Version>1.0.0</Version>
    <ApplicationIcon>../../assets/routine.ico</ApplicationIcon><ApplicationManifest>../app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../web/*" Link="Web/%(Filename)%(Extension)" /><Resource Include="../../assets/routine.ico" Link="Art/routine.ico" /></ItemGroup>
</Project>
