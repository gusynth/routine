<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Routine.Setup</AssemblyName><Version>1.0.0</Version>
    <ApplicationIcon>../assets/routine.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile><IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Resource Include="Fonts/Inter-Regular.ttf" />
    <Resource Include="Fonts/Inter-Medium.ttf" />
    <Resource Include="../assets/routine.png" Link="Art/routine.png" />
    <Resource Include="../assets/routine.ico" Link="Art/routine.ico" />
    <Resource Include="../assets/routine-wordmark.xaml" Link="Art/wordmark.xaml" />
    <Resource Include="Art/hero.png" />
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="Routine.Payload.zip" Condition="'$(PayloadPath)' != ''" />
    <EmbeddedResource Include="web/setup.html;web/lucide.min.js;web/lucide-LICENSE.txt" />
    <Compile Remove="tests/**/*.cs;preview/**/*.cs" />
  </ItemGroup>
</Project>
